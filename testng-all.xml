<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Multi-Project Automation Suite (3 Projects)" verbose="2">
    <listeners>
        <listener class-name="com.ecommerce.listeners.TestListener"/>
    </listeners>

    <!-- PROJECT 1: NOI THAT & PHONG THUY -->
    <test name="Project 1: Noi That Admin Portal">
        <classes>
            <class name="com.ecommerce.tests.noithat.AdminProductManagementTest"/>
            <class name="com.ecommerce.tests.noithat.AdminOrderManagementTest"/>
        </classes>
    </test>

    <test name="Project 1: Noi That Storefront">
        <classes>
            <class name="com.ecommerce.tests.noithat.StorefrontAuthTest"/>
            <class name="com.ecommerce.tests.noithat.StorefrontCatalogTest"/>
            <class name="com.ecommerce.tests.noithat.PhongThuyConsultationTest"/>
            <class name="com.ecommerce.tests.noithat.ProductDetailTest"/>
            <class name="com.ecommerce.tests.noithat.CartTest"/>
            <class name="com.ecommerce.tests.noithat.CheckoutFlowTest"/>
        </classes>
    </test>

    <!-- PROJECT 1: API LAYER (backend Express + Prisma) -->
    <test name="Project 1: Noi That Backend API">
        <classes>
            <class name="com.ecommerce.tests.api.NoiThatApiTest"/>
        </classes>
    </test>

    <!-- PROJECT 2: SHOPNOVA MARKETPLACE -->
    <test name="Project 2: ShopNova Buyer Flows">
        <classes>
            <class name="com.ecommerce.tests.novashop.NovaAuthTest"/>
            <class name="com.ecommerce.tests.novashop.NovaProductSearchTest"/>
        </classes>
    </test>

    <test name="Project 2: ShopNova Seller Portal">
        <classes>
            <class name="com.ecommerce.tests.novashop.NovaSellerManagementTest"/>
        </classes>
    </test>

    <!-- PROJECT 3: QR REPAIR TICKET SYSTEM -->
    <test name="Project 3: QR Repair Customer Flows">
        <classes>
            <class name="com.ecommerce.tests.repair.RepairNavigationTest"/>
            <class name="com.ecommerce.tests.repair.RepairTrackingTest"/>
            <class name="com.ecommerce.tests.repair.RepairBookingTest"/>
        </classes>
    </test>

    <test name="Project 3: QR Repair Staff Portal">
        <classes>
            <class name="com.ecommerce.tests.repair.RepairAuthTest"/>
        </classes>
    </test>

    <!-- PROJECT 4: WEBSITE_NOITHAT (GO GIN + ASTRO + VITE REACT - NGUYENBANG01) -->
    <test name="Project 4: Website_NoiThat Go Backend API">
        <classes>
            <class name="com.ecommerce.tests.noithatbang.BangApiTest"/>
        </classes>
    </test>

    <test name="Project 4: Website_NoiThat Storefront">
        <classes>
            <class name="com.ecommerce.tests.noithatbang.BangStorefrontTest"/>
            <class name="com.ecommerce.tests.noithatbang.BangCheckoutTest"/>
        </classes>
    </test>

    <test name="Project 4: Website_NoiThat Admin Portal">
        <classes>
            <class name="com.ecommerce.tests.noithatbang.BangAdminAuthTest"/>
            <class name="com.ecommerce.tests.noithatbang.BangAdminProductTest"/>
        </classes>
    </test>
</suite>
