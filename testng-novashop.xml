<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ShopNova E-Commerce Marketplace Suite (Project 2)" verbose="2">
    <listeners>
        <listener class-name="com.ecommerce.listeners.TestListener"/>
    </listeners>

    <test name="ShopNova Buyer &amp; Marketplace Flow">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ecommerce.tests.novashop.NovaAuthTest"/>
            <class name="com.ecommerce.tests.novashop.NovaRegisterTest"/>
            <class name="com.ecommerce.tests.novashop.NovaProductSearchTest"/>
            <class name="com.ecommerce.tests.novashop.NovaProductDetailTest"/>
            <class name="com.ecommerce.tests.novashop.NovaCartCheckoutTest"/>
            <class name="com.ecommerce.tests.novashop.NovaBuyerOrdersTest"/>
        </classes>
    </test>

    <test name="ShopNova Seller Portal">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ecommerce.tests.novashop.NovaSellerManagementTest"/>
            <class name="com.ecommerce.tests.novashop.NovaSellerProductCRUDTest"/>
        </classes>
    </test>
</suite>
