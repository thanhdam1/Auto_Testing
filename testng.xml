<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="E-Commerce Full Test Automation Suite" verbose="2">
    <listeners>
        <listener class-name="com.ecommerce.listeners.TestListener"/>
    </listeners>

    <test name="SauceDemo E-Commerce Core Flows">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.ecommerce.tests.saucedemo.LoginTest"/>
            <class name="com.ecommerce.tests.saucedemo.ProductCatalogTest"/>
            <class name="com.ecommerce.tests.saucedemo.CartTest"/>
            <class name="com.ecommerce.tests.saucedemo.CheckoutE2ETest"/>
        </classes>
    </test>
</suite>
